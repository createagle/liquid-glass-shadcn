  "css": {
    "@layer base": {
      ":root[data-glass-contrast='more']": {
        "--lg-stroke-boost": "1.8",
        "--lg-knob-fill": "rgb(255 255 255 / 0.96)",
        "--lg-grabber-fill": "rgb(0 0 0 / 0.45)",
        "--lg-label-secondary": "rgb(var(--lg-label-tint-light) / 0.85)",
        "--lg-label-tertiary": "rgb(var(--lg-label-tint-light) / 0.6)",
        "--lg-label-quaternary": "rgb(var(--lg-label-tint-light) / 0.4)",
        "--lg-separator": "rgb(var(--lg-separator-tint-light) / 0.6)",
        "--lg-separator-opaque": "#8e8e93",
        "--lg-list-separator": "rgb(0 0 0 / 0.3)",
        "--lg-toggle-fill": "rgb(0 0 0 / 0.34)",
        "--lg-toggle-fill-pressed": "rgb(0 0 0 / 0.46)",
        "--lg-toggle-fill-disabled": "rgb(0 0 0 / 0.18)",
        "--lg-disclosure-fill": "rgb(0 0 0 / 0.3)",
        "--lg-disclosure-fill-pressed": "rgb(0 0 0 / 0.44)",
        "--lg-scrollbar-thumb": "rgb(0 0 0 / 0.8)",
        "--lg-table-row-alt": "rgb(0 0 0 / 0.14)",
        "--lg-refract-scale": "0.5",
        "--lg-disperse-scale": "0.4",
        "--muted-foreground": "var(--lg-label-secondary)",
        "--border": "var(--lg-separator)",
        "--input": "var(--lg-separator)"
      },
      ":root[data-glass-contrast='more'][data-glass-theme='dark'], .dark:root[data-glass-contrast='more']": {
        "--lg-label-secondary": "rgb(var(--lg-label-tint-dark) / 0.9)",
        "--lg-label-tertiary": "rgb(var(--lg-label-tint-dark) / 0.7)",
        "--lg-label-quaternary": "rgb(var(--lg-label-tint-dark) / 0.5)",
        "--lg-separator": "rgb(200 200 210 / 0.7)",
        "--lg-separator-opaque": "#6e6e73",
        "--lg-list-separator": "rgb(255 255 255 / 0.36)",
        "--lg-grabber-fill": "rgb(255 255 255 / 0.55)",
        "--lg-toggle-fill": "rgb(255 255 255 / 0.38)",
        "--lg-toggle-fill-pressed": "rgb(255 255 255 / 0.5)",
        "--lg-toggle-fill-disabled": "rgb(255 255 255 / 0.2)",
        "--lg-disclosure-fill": "rgb(255 255 255 / 0.34)",
        "--lg-disclosure-fill-pressed": "rgb(255 255 255 / 0.48)",
        "--lg-scrollbar-thumb": "rgb(255 255 255 / 0.85)",
        "--lg-table-row-alt": "rgb(255 255 255 / 0.16)",
        "--muted-foreground": "var(--lg-label-secondary)",
        "--border": "var(--lg-separator)",
        "--input": "var(--lg-separator)"
      }
    },
    "@layer components": {
      ".lg-surface": {
        "position": "relative",
        "isolation": "isolate",
        "border-radius": "var(--lg-surface-radius, var(--lg-radius-md))",
        "color": "var(--lg-label)",
        "transition": "background-color 240ms linear, box-shadow 240ms linear"
      },
      "@supports (corner-shape: squircle)": {
        ".lg-surface[data-continuous='true']": {
          "corner-shape": "squircle"
        },
        ".lg-continuous": {
          "corner-shape": "squircle"
        }
      },
      ":root[data-glass-motion='reduced'] .lg-surface": {
        "transition-duration": "120ms"
      },
      ".lg-surface[data-layer='base']": {
        "background-color": "rgb(var(--lg-base-color) / var(--lg-base-alpha))",
        "box-shadow": "inset 0 1px 0 0 var(--lg-stroke-top),\n    inset 0 -1px 0 0 var(--lg-stroke-bottom),\n    var(--lg-shadow)"
      },
      ".lg-surface[data-layer='elevated']": {
