      "css": {
        "@layer base": {
          ":root[data-glass-contrast='more']": {
            "--lg-stroke-strength": "1.8",
            "--lg-label-secondary": "rgb(var(--lg-label-tint-light) / 0.85)",
            "--lg-label-tertiary": "rgb(var(--lg-label-tint-light) / 0.6)",
            "--lg-label-quaternary": "rgb(var(--lg-label-tint-light) / 0.4)",
            "--lg-separator": "rgb(var(--lg-separator-tint-light) / 0.6)",
            "--lg-separator-opaque": "#8e8e93",
            "--lg-refract-scale": "0.5",
            "--lg-disperse-scale": "0.4",
            "--lg-stroke-top": "rgb(255 255 255 / calc(0.62 * var(--lg-stroke-strength)))",
            "--lg-stroke-bottom": "rgb(0 0 0 / calc(0.1 * var(--lg-stroke-strength)))",
            "--lg-stroke-side": "rgb(255 255 255 / calc(0.3 * var(--lg-stroke-strength)))",
            "--muted-foreground": "var(--lg-label-secondary)",
            "--border": "var(--lg-separator)",
            "--input": "var(--lg-separator)"
          },
          ":root[data-glass-contrast='more'][data-glass-theme='dark'], .dark:root[data-glass-contrast='more']": {
            "--lg-label-secondary": "rgb(var(--lg-label-tint-dark) / 0.9)",
            "--lg-label-tertiary": "rgb(var(--lg-label-tint-dark) / 0.7)",
            "--lg-label-quaternary": "rgb(var(--lg-label-tint-dark) / 0.5)",
            "--lg-separator": "rgb(200 200 210 / 0.7)",
            "--lg-separator-opaque": "#6e6e73",
            "--lg-stroke-top": "rgb(255 255 255 / calc(0.3 * var(--lg-stroke-strength)))",
            "--lg-stroke-bottom": "rgb(0 0 0 / calc(0.34 * var(--lg-stroke-strength)))",
            "--lg-stroke-side": "rgb(255 255 255 / calc(0.16 * var(--lg-stroke-strength)))",
            "--muted-foreground": "var(--lg-label-secondary)",
            "--border": "var(--lg-separator)",
            "--input": "var(--lg-separator)"
          }
        },
        "@layer components": {
          ".lg-surface": {
            "position": "relative",
            "isolation": "isolate",
            "border-radius": "var(--lg-surface-radius, var(--lg-radius-md))",
            "color": "var(--lg-label)",
            "transition": "background-color 240ms linear,\n    box-shadow 240ms linear"
          },
          "@supports (corner-shape: squircle)": {
            ".lg-surface[data-continuous='true']": {
              "corner-shape": "squircle"
            },
            ".lg-continuous": {
              "corner-shape": "squircle"
            }
          },
          ":root[data-glass-motion='reduced'] .lg-surface": {
            "transition-duration": "120ms"
          },
          ".lg-surface[data-layer='base']": {
            "background-color": "rgb(var(--lg-base-color) / var(--lg-base-alpha))",
            "box-shadow": "inset 0 1px 0 0 var(--lg-stroke-top),\n    inset 0 -1px 0 0 var(--lg-stroke-bottom),\n    var(--lg-shadow)"
          },
          ".lg-surface[data-layer='elevated']": {
            "background-color": "rgb(var(--lg-elevated-color) / min(1, calc(var(--lg-base-alpha) + 0.12)))",
            "box-shadow": "inset 0 1px 0 0 var(--lg-stroke-top),\n    inset 0 -1px 0 0 var(--lg-stroke-bottom),\n    var(--lg-shadow),\n    var(--lg-glow)"
          },
          ".lg-surface[data-layer='indicator']": {
            "background-color": "transparent",
            "box-shadow": "inset 0 1.5px 1px -0.5px rgb(255 255 255 / calc(0.92 * var(--lg-specular-opacity))),\n    \n    inset 0 -1px 1px -0.5px rgb(0 0 0 / 0.28),\n    \n    inset 1px 0 1px -0.5px var(--lg-stroke-side),\n    inset -1px 0 1px -0.5px var(--lg-stroke-side),\n    0 3px 10px rgb(0 0 0 / 0.26)"
          },
          "[data-glass-tier='a'] .lg-surface[data-layer='base'], [data-glass-tier='a'] .lg-surface[data-layer='elevated']": {
            "backdrop-filter": "blur(var(--lg-base-blur)) saturate(var(--lg-base-saturate))",
            "-webkit-backdrop-filter": "blur(var(--lg-base-blur)) saturate(var(--lg-base-saturate))"
          },
          "[data-glass-tier='a'] .lg-surface[data-layer='indicator']": {
            "backdrop-filter": "brightness(1.06) saturate(1.22)"
          },
          "[data-glass-tier='b'] .lg-surface[data-layer='base'], [data-glass-tier='b'] .lg-surface[data-layer='elevated']": {
            "backdrop-filter": "blur(var(--lg-base-blur)) saturate(var(--lg-base-saturate))",
            "-webkit-backdrop-filter": "blur(var(--lg-base-blur)) saturate(var(--lg-base-saturate))"
          },
          "[data-glass-tier='b'] .lg-surface[data-layer='indicator']": {
            "backdrop-filter": "blur(1px) brightness(1.12) saturate(1.3)",
            "-webkit-backdrop-filter": "blur(1px) brightness(1.12) saturate(1.3)",
            "box-shadow": "inset 0 1.5px 1px -0.5px rgb(255 255 255 / calc(0.92 * var(--lg-specular-opacity))),\n    inset 0 -1px 1px -0.5px rgb(0 0 0 / 0.3),\n    \n    inset 0 0 2px 1px rgb(255 255 255 / 0.16),\n    inset 0 0 8px 3px rgb(255 255 255 / 0.08),\n    0 3px 10px rgb(0 0 0 / 0.26)"
          },
          ".lg-surface[data-layer='indicator'][data-refraction='off']": {
            "backdrop-filter": "blur(1px) brightness(1.12) saturate(1.3)",
            "-webkit-backdrop-filter": "blur(1px) brightness(1.12) saturate(1.3)",
            "box-shadow": "inset 0 1.5px 1px -0.5px rgb(255 255 255 / calc(0.92 * var(--lg-specular-opacity))),\n    inset 0 -1px 1px -0.5px rgb(0 0 0 / 0.3),\n    inset 0 0 2px 1px rgb(255 255 255 / 0.16),\n    inset 0 0 8px 3px rgb(255 255 255 / 0.08),\n    0 3px 10px rgb(0 0 0 / 0.26)"
          },
          "[data-glass-tier='b'] .lg-surface[data-layer='indicator']::before, .lg-surface[data-layer='indicator'][data-refraction='off']::before": {
            "content": "''",
            "position": "absolute",
            "inset": "0",
            "border-radius": "inherit",
            "padding": "1.5px",
            "background": "linear-gradient(\n    135deg,\n    rgb(255 110 180 / 0.55) 0%,\n    rgb(120 200 255 / 0.15) 35%,\n    rgb(140 255 220 / 0.12) 60%,\n    rgb(180 130 255 / 0.5) 100%\n  )",
            "mask": "linear-gradient(#000 0 0) content-box,\n    linear-gradient(#000 0 0)",
            "mask-composite": "exclude",
            "-webkit-mask": "linear-gradient(#000 0 0) content-box,\n    linear-gradient(#000 0 0)",
            "-webkit-mask-composite": "xor",
            "pointer-events": "none"
          },
          "[data-glass-tier='c'] .lg-surface[data-layer='base'], [data-glass-tier='c'] .lg-surface[data-layer='elevated']": {
            "background-color": "rgb(var(--lg-base-color) / min(1, calc(var(--lg-base-alpha) + 0.26)))"
          },
          "[data-glass-tier='c'] .lg-surface[data-layer='indicator']": {
            "background": "linear-gradient(\n    180deg,\n    rgb(255 255 255 / 0.32) 0%,\n    rgb(255 255 255 / 0.16) 46%,\n    rgb(255 255 255 / 0.22) 100%\n  )",
            "box-shadow": "inset 0 1px 0 0 rgb(255 255 255 / 0.75),\n    inset 0 -1px 0 0 rgb(0 0 0 / 0.2),\n    0 2px 8px rgb(0 0 0 / 0.22)"
          },
          "[data-glass-tier='c'][data-glass-theme='dark'] .lg-surface[data-layer='indicator']": {
            "background": "linear-gradient(\n    180deg,\n    rgb(255 255 255 / 0.2) 0%,\n    rgb(255 255 255 / 0.08) 46%,\n    rgb(255 255 255 / 0.13) 100%\n  )"
          },
          ".lg-surface[data-layer='indicator'][data-pressed='true']": {
            "box-shadow": "inset 0 2px 1.5px -0.5px rgb(255 255 255 / var(--lg-specular-opacity)),\n    inset 0 -1.5px 1.5px -0.5px rgb(0 0 0 / 0.34),\n    inset 1px 0 1.5px -0.5px var(--lg-stroke-side),\n    inset -1px 0 1.5px -0.5px var(--lg-stroke-side),\n    0 5px 16px rgb(0 0 0 / 0.32)"
          },
          "[data-glass-tier='a'] .lg-surface[data-layer='indicator'][data-pressed='true']": {
            "backdrop-filter": "brightness(1.12) saturate(1.4)"
          },
          ".lg-surface:focus-visible": {
            "outline": "2px solid var(--lg-ring, rgb(10 132 255))",
            "outline-offset": "2px"
          },
          ".lg-content": {
            "background-color": "var(--lg-content-regular)",
            "color": "var(--lg-label-primary)"
          },
          ".lg-content[data-material='ultrathin']": {
            "background-color": "var(--lg-content-ultrathin)"
          },
          ".lg-content[data-material='thin']": {
            "background-color": "var(--lg-content-thin)"
          },
          ".lg-content[data-material='regular']": {
            "background-color": "var(--lg-content-regular)"
          },
          ".lg-content[data-material='thick']": {
            "background-color": "var(--lg-content-thick)"
          },
          "[data-glass-tier='a'] .lg-content, [data-glass-tier='b'] .lg-content": {
            "backdrop-filter": "blur(var(--lg-content-blur)) saturate(1.4)",
            "-webkit-backdrop-filter": "blur(var(--lg-content-blur)) saturate(1.4)"
          },
          "[data-glass-tier='c'] .lg-content": {
            "background-color": "var(--lg-content-thick)"
          },
          "@media (prefers-reduced-transparency: reduce)": {
            ":root": {
              "--lg-base-alpha": "0.98",
              "--lg-refract-scale": "0",
              "--lg-disperse-scale": "0"
            },
            ".lg-surface, .lg-content": {
              "backdrop-filter": "none !important",
              "-webkit-backdrop-filter": "none !important"
            },
            ".lg-surface[data-layer='indicator']": {
              "background-color": "rgb(var(--lg-base-color) / 0.98)"
            }
          },
          "@media (prefers-reduced-motion: reduce)": {
            ".lg-surface": {
              "transition-duration": "120ms"
            }
          }
        }
      },
      "docs": "已安装 Liquid Glass 主题。\n\n还需要两步：\n1) 安装光学引擎：pnpm add @glass/core\n2) 确认你的 globals.css 里有 shadcn 默认的暗色变体声明：\n   @custom-variant dark (&:is(.dark *));\n   （shadcn init 会自动写入。缺了它，dark: 工具类不会跟随 .dark 类。）\n\n在应用根组件挂上 <GlassProvider>，并在 <head> 注入 glassSsrScript() 以避免首屏闪烁。",
      "categories": [
        "theme",
        "liquid-glass"
      ]
    }
  ]
